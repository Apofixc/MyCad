{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyCad",
  "version": "0.1.0",
  "identifier": "ru.mycad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyCad — реверс-инжиниринг печатных плат",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
