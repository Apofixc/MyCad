{
  "name": "mycad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:native": "playwright test tests/e2e/native-app-full.native.spec.ts --project=native-webview2",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:scan": "playwright test tests/e2e/background-image-ui.spec.ts --project=browser-ui --headed",
    "test:scan:native": "playwright test tests/e2e/background-image.native.spec.ts --project=native-webview2",
    "test:image:full": "playwright test tests/e2e/image-workflow-full.native.spec.ts --project=native-webview2",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
